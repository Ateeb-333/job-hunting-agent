# Streamlit Cloud secrets — paste this content into your app's
# Settings -> Secrets pane on share.streamlit.io.
#
# Locally, you can either:
#   - put the same key into a `.env` file in the project root (gitignored), OR
#   - copy this file to `.streamlit/secrets.toml` (also gitignored)
#
# Both `.env` and `.streamlit/secrets.toml` are excluded from git via .gitignore.

OPENROUTER_API_KEY = "sk-or-v1-replace-me"

# Optional: pick a different model. Default is anthropic/claude-haiku-4.5.
# OPENROUTER_MODEL = "anthropic/claude-haiku-4.5"
