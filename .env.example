# Copy this file to `.env` and fill in your real key.
# `.env` is gitignored — never commit your API key.
#
# Get an OpenRouter key at https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-...

# Optional: pick a different model. Default is anthropic/claude-haiku-4.5 (fast, cheap, good).
# Other useful options:
#   anthropic/claude-sonnet-4.6        (better quality, slower, pricier)
#   openai/gpt-4o-mini                 (cheap and decent)
#   meta-llama/llama-3.3-70b-instruct  (cheapest)
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5
